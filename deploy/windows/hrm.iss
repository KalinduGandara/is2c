; Premium HRM - Windows installer (Inno Setup 6.3+).
; Build with build.ps1, which stages the files and passes AppVersion, StageDir and RedistFile:
;   iscc /DAppVersion=1.2.0 /DStageDir=build\stage /DRedistFile=build\cache\vc_redist.x64.exe hrm.iss
;
; Installs into {app}: app\hrm.jar (Spring Boot + SPA), jre\ (Java 21), pgsql\ (PostgreSQL 17 binaries),
; caddy\caddy.exe (HTTPS), service\hrm-app.exe (WinSW), scripts\*.ps1, docs\user-guide\.
; The data folder (default C:\ProgramData\PremiumHRM) holds config, database, documents, backups and logs; it
; survives upgrades and, unless the user says otherwise, uninstalling. scripts\setup.ps1 does the configuration.

#ifndef AppVersion
  #define AppVersion "0.0.0"
#endif
#ifndef StageDir
  #define StageDir "build\stage"
#endif
#ifndef RedistFile
  #define RedistFile "build\cache\vc_redist.x64.exe"
#endif
#define AppName "Premium HRM"
#define RegKey "Software\IS2C\Premium HRM"

[Setup]
AppId={{6F1C2B7E-3D4A-4E8B-9C21-7A5D0E3F9B14}
AppName={#AppName}
AppVersion={#AppVersion}
AppVerName={#AppName} {#AppVersion}
AppPublisher=IS2C
VersionInfoVersion={#AppVersion}
DefaultDirName={autopf}\{#AppName}
DisableProgramGroupPage=yes
PrivilegesRequired=admin
ArchitecturesAllowed=x64compatible
ArchitecturesInstallIn64BitMode=x64compatible
; Windows 10 1809 / Server 2019: tar.exe, Get-NetTCPConnection, builtin service accounts
MinVersion=10.0.17763
WizardStyle=modern
Compression=lzma2/max
SolidCompression=yes
OutputBaseFilename=PremiumHRM-Setup-{#AppVersion}
SetupLogging=yes
CloseApplications=no
UninstallDisplayName={#AppName}

[Files]
Source: "{#StageDir}\*"; DestDir: "{app}"; Flags: ignoreversion recursesubdirs createallsubdirs
; used by the wizard before anything is installed
Source: "{#StageDir}\scripts\check-port.ps1"; Flags: dontcopy
Source: "{#RedistFile}"; Flags: dontcopy

[InstallDelete]
; runtimes are replaced as a whole on upgrade (services are stopped in PrepareToInstall)
Type: filesandordirs; Name: "{app}\jre"
Type: filesandordirs; Name: "{app}\pgsql"
Type: filesandordirs; Name: "{app}\app"

[Dirs]
Name: "{autoprograms}\{#AppName}"

[Registry]
Root: HKLM64; Subkey: "{#RegKey}"; ValueType: string; ValueName: "DataDir"; ValueData: "{code:GetDataDir}"; Flags: uninsdeletekey

[INI]
Filename: "{autoprograms}\{#AppName}\{#AppName}.url"; Section: "InternetShortcut"; Key: "URL"; String: "{code:GetAppUrl}"

[Icons]
Name: "{autoprograms}\{#AppName}\User guide"; Filename: "{app}\docs\user-guide\index.html"
Name: "{autoprograms}\{#AppName}\Data folder"; Filename: "{code:GetDataDir}"

[Run]
Filename: "{code:GetAppUrl}"; Description: "Open {#AppName} in the browser"; Flags: postinstall shellexec nowait skipifsilent

[UninstallRun]
Filename: "{sys}\WindowsPowerShell\v1.0\powershell.exe"; \
  Parameters: "-NoProfile -NonInteractive -ExecutionPolicy Bypass -File ""{app}\scripts\uninstall.ps1"" -DataDir ""{code:GetDataDir}"""; \
  Flags: runhidden waituntilterminated; RunOnceId: "RemoveServices"

[UninstallDelete]
Type: files; Name: "{autoprograms}\{#AppName}\{#AppName}.url"
Type: dirifempty; Name: "{autoprograms}\{#AppName}"
; hrm-app.xml is generated by setup.ps1
Type: filesandordirs; Name: "{app}\service"
Type: dirifempty; Name: "{app}"

[Code]
var
  DataDirPage: TInputDirWizardPage;
  NetworkPage: TInputQueryWizardPage;
  AdminPage: TInputQueryWizardPage;
  UninstallDataDir: String;

function PowerShellExe: String;
begin
  Result := ExpandConstant('{sys}\WindowsPowerShell\v1.0\powershell.exe');
end;

function RunPowerShell(const Params: String; var ResultCode: Integer): Boolean;
begin
  Result := Exec(PowerShellExe, '-NoProfile -NonInteractive -ExecutionPolicy Bypass ' + Params, '',
    SW_HIDE, ewWaitUntilTerminated, ResultCode);
end;

function GetDataDir(Param: String): String;
begin
  Result := RemoveBackslashUnlessRoot(Trim(DataDirPage.Values[0]));
end;

function ConfigFile(const Name: String): String;
begin
  Result := AddBackslash(GetDataDir('')) + 'config\' + Name;
end;

{ An existing configuration means upgrade/repair, or reinstalling onto data kept at uninstall: setup.ps1 reuses it. }
function IsExistingInstall: Boolean;
begin
  Result := FileExists(ConfigFile('hrm.properties'));
end;

function GetAppUrl(Param: String): String;
var
  Host, Port: String;
begin
  if IsExistingInstall then begin
    Host := GetIniString('install', 'Hostname', 'localhost', ConfigFile('install.ini'));
    Port := GetIniString('install', 'HttpsPort', '443', ConfigFile('install.ini'));
  end else begin
    Host := Lowercase(Trim(NetworkPage.Values[0]));
    Port := Trim(NetworkPage.Values[1]);
  end;
  Result := 'https://' + Host;
  if Port <> '443' then
    Result := Result + ':' + Port;
  Result := Result + '/';
end;

{ '' when the TCP port is free, otherwise what holds it (listening program/service or a Windows-reserved range). }
function PortOwner(Port: Integer): String;
var
  ResultCode: Integer;
  OutFile: String;
  Owner: AnsiString;
begin
  Result := '';
  ExtractTemporaryFile('check-port.ps1');
  OutFile := ExpandConstant('{tmp}\port-' + IntToStr(Port) + '.txt');
  DeleteFile(OutFile);
  if RunPowerShell('-File "' + ExpandConstant('{tmp}\check-port.ps1') + '" -Port ' + IntToStr(Port) +
      ' -OutFile "' + OutFile + '"', ResultCode) and (ResultCode = 1) then begin
    if LoadStringFromFile(OutFile, Owner) then
      Result := Trim(String(Owner))
    else
      Result := 'another program';
  end;
end;

function ValidPort(const S: String): Boolean;
var
  N: Integer;
begin
  N := StrToIntDef(Trim(S), 0);
  Result := (N >= 1) and (N <= 65535);
end;

function ValidHostname(const S: String): Boolean;
var
  I: Integer;
  C: Char;
begin
  Result := Length(S) > 0;
  for I := 1 to Length(S) do begin
    C := S[I];
    if not (((C >= 'a') and (C <= 'z')) or ((C >= '0') and (C <= '9')) or (C = '.') or (C = '-')) then
      Result := False;
  end;
end;

{ Mirrors PasswordPolicy.java: 10+ characters, upper, lower, digit, symbol. '' when the password is acceptable. }
function PasswordProblem(const P: String): String;
var
  I: Integer;
  C: Char;
  Upper, Lower, Digit, Symbol: Boolean;
begin
  Upper := False; Lower := False; Digit := False; Symbol := False;
  for I := 1 to Length(P) do begin
    C := P[I];
    if (C >= 'A') and (C <= 'Z') then Upper := True
    else if (C >= 'a') and (C <= 'z') then Lower := True
    else if (C >= '0') and (C <= '9') then Digit := True
    else Symbol := True;
  end;
  Result := '';
  if Length(P) < 10 then Result := 'at least 10 characters'
  else if not Upper then Result := 'an upper-case letter'
  else if not Lower then Result := 'a lower-case letter'
  else if not Digit then Result := 'a digit'
  else if not Symbol then Result := 'a symbol such as # or !';
end;

procedure InitializeWizard;
begin
  DataDirPage := CreateInputDirPage(wpSelectDir, 'Data folder', 'Where should Premium HRM keep its data?',
    'The database, uploaded documents, backups, logs and configuration are stored in this folder. ' +
    'Use a local disk with enough free space (50 GB recommended). Only administrators can open it.',
    False, '');
  DataDirPage.Add('');
  DataDirPage.Values[0] := GetPreviousData('DataDir', ExpandConstant('{commonappdata}\PremiumHRM'));

  NetworkPage := CreateInputQueryPage(DataDirPage.ID, 'Web address', 'How will users reach Premium HRM?',
    'Enter the host name users type in the browser: a DNS name such as hrm.local, or this server''s IP address. ' +
    'HTTP requests are redirected to HTTPS. Setup checks that the ports are free.');
  NetworkPage.Add('Host name:', False);
  NetworkPage.Add('HTTPS port:', False);
  NetworkPage.Add('HTTP port:', False);
  NetworkPage.Values[0] := Lowercase(GetComputerNameString);
  NetworkPage.Values[1] := '443';
  NetworkPage.Values[2] := '80';

  AdminPage := CreateInputQueryPage(NetworkPage.ID, 'First administrator', 'Create the first sign-in account',
    'This Super Administrator account is created on the empty database and must choose a new password at first ' +
    'sign-in. The password needs at least 10 characters with upper- and lower-case letters, a digit and a symbol.');
  AdminPage.Add('User name:', False);
  AdminPage.Add('Password:', True);
  AdminPage.Add('Confirm password:', True);
  AdminPage.Values[0] := 'admin';
end;

procedure RegisterPreviousData(PreviousDataKey: Integer);
begin
  SetPreviousData(PreviousDataKey, 'DataDir', GetDataDir(''));
end;

function ShouldSkipPage(PageID: Integer): Boolean;
begin
  Result := False;
  if (PageID = DataDirPage.ID) then
    { upgrade: keep the recorded data folder }
    Result := (GetPreviousData('DataDir', '') <> '') and IsExistingInstall
  else if (PageID = NetworkPage.ID) or (PageID = AdminPage.ID) then
    Result := IsExistingInstall;
end;

function NextButtonClick(CurPageID: Integer): Boolean;
var
  Owner, Problem: String;
  HttpsPort, HttpPort: Integer;
begin
  Result := True;
  if CurPageID = DataDirPage.ID then begin
    if (Length(GetDataDir('')) < 4) or (Copy(GetDataDir(''), 1, 2) = '\\') then begin
      MsgBox('Choose a folder on a local disk, for example C:\ProgramData\PremiumHRM.', mbError, MB_OK);
      Result := False;
    end else if IsExistingInstall then
      MsgBox('This folder already contains Premium HRM data. Setup will reuse it: the database, settings, ' +
        'ports and accounts stay as they are.', mbInformation, MB_OK);
  end else if CurPageID = NetworkPage.ID then begin
    NetworkPage.Values[0] := Lowercase(Trim(NetworkPage.Values[0]));
    if not ValidHostname(NetworkPage.Values[0]) then begin
      MsgBox('Enter a host name (letters, digits, dots and hyphens) or an IPv4 address.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    if not ValidPort(NetworkPage.Values[1]) or not ValidPort(NetworkPage.Values[2]) then begin
      MsgBox('Ports must be numbers from 1 to 65535.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    HttpsPort := StrToInt(Trim(NetworkPage.Values[1]));
    HttpPort := StrToInt(Trim(NetworkPage.Values[2]));
    if HttpsPort = HttpPort then begin
      MsgBox('The HTTPS and HTTP ports must be different.', mbError, MB_OK);
      Result := False;
      exit;
    end;
    Owner := PortOwner(HttpsPort);
    if Owner = '' then begin
      Owner := PortOwner(HttpPort);
      if Owner <> '' then HttpsPort := HttpPort;
    end;
    if Owner <> '' then begin
      MsgBox('Port ' + IntToStr(HttpsPort) + ' is already in use by ' + Owner + '.' + #13#10#13#10 +
        'Stop or reconfigure that program, or enter a different port. Ports 80 and 443 are often taken by IIS ' +
        '("World Wide Web Publishing Service") or another web server.', mbError, MB_OK);
      Result := False;
    end;
  end else if CurPageID = AdminPage.ID then begin
    AdminPage.Values[0] := Trim(AdminPage.Values[0]);
    Problem := PasswordProblem(AdminPage.Values[1]);
    if AdminPage.Values[0] = '' then begin
      MsgBox('Enter a user name.', mbError, MB_OK);
      Result := False;
    end else if Problem <> '' then begin
      MsgBox('The password needs ' + Problem + '.', mbError, MB_OK);
      Result := False;
    end else if AdminPage.Values[1] <> AdminPage.Values[2] then begin
      MsgBox('The passwords do not match.', mbError, MB_OK);
      Result := False;
    end;
  end;
end;

function UpdateReadyMemo(Space, NewLine, MemoUserInfoInfo, MemoDirInfo, MemoTypeInfo, MemoComponentsInfo,
  MemoGroupInfo, MemoTasksInfo: String): String;
begin
  Result := MemoDirInfo + NewLine + NewLine + 'Data folder:' + NewLine + Space + GetDataDir('') + NewLine + NewLine;
  if IsExistingInstall then
    Result := Result + 'Existing installation:' + NewLine + Space +
      'a backup is taken and the services are stopped, updated and restarted.' + NewLine + Space +
      'Database changes are applied automatically when the app starts.' + NewLine + NewLine
  else
    Result := Result + 'Administrator:' + NewLine + Space + AdminPage.Values[0] + NewLine + NewLine;
  Result := Result + 'Web address:' + NewLine + Space + GetAppUrl('');
end;

{ Upgrade: back up with the installed version's script, then stop the services so their files can be replaced. }
function PrepareToInstall(var NeedsRestart: Boolean): String;
var
  ResultCode: Integer;
  BackupScript: String;
begin
  Result := '';
  if not IsExistingInstall then
    exit;
  BackupScript := ExpandConstant('{app}\scripts\backup.ps1');
  if FileExists(BackupScript) then begin
    WizardForm.PreparingLabel.Caption := 'Backing up the database and documents...';
    if not RunPowerShell('-File "' + BackupScript + '" -DataDir "' + GetDataDir('') + '"', ResultCode)
        or (ResultCode <> 0) then
      if MsgBox('The backup before the upgrade failed (see ' + GetDataDir('') + '\logs\backup.log).' + #13#10#13#10 +
          'Continue without a fresh backup?', mbConfirmation, MB_YESNO or MB_DEFBUTTON2) <> IDYES then begin
        Result := 'Upgrade cancelled because the backup failed. Nothing was changed.';
        exit;
      end;
  end;
  RunPowerShell('-Command "Stop-Service -Name HRM-Caddy,HRM-App,HRM-PostgreSQL -Force -ErrorAction SilentlyContinue"',
    ResultCode);
end;

function VCRedistInstalled: Boolean;
var
  Installed: Cardinal;
begin
  Result := RegQueryDWordValue(HKLM64, 'SOFTWARE\Microsoft\VisualStudio\14.0\VC\Runtimes\x64', 'Installed', Installed)
    and (Installed = 1);
end;

procedure InstallVCRedist;
var
  ResultCode: Integer;
begin
  if VCRedistInstalled then
    exit;
  WizardForm.StatusLabel.Caption := 'Installing the Microsoft Visual C++ runtime (needed by PostgreSQL)...';
  ExtractTemporaryFile(ExtractFileName('{#RedistFile}'));
  if not Exec(ExpandConstant('{tmp}\') + ExtractFileName('{#RedistFile}'), '/install /quiet /norestart', '',
      SW_HIDE, ewWaitUntilTerminated, ResultCode)
      or not ((ResultCode = 0) or (ResultCode = 3010) or (ResultCode = 1638)) then
    MsgBox('Installing the Microsoft Visual C++ runtime failed (code ' + IntToStr(ResultCode) + '). ' +
      'PostgreSQL may not start; install it from https://aka.ms/vs/17/release/vc_redist.x64.exe and run setup again.',
      mbError, MB_OK);
end;

{ The wizard answers go to setup.ps1 in a temp file (deleted with {tmp}), never on a command line. }
procedure WriteAnswers(const FileName: String);
var
  Lines: TArrayOfString;
begin
  SetArrayLength(Lines, 7);
  Lines[0] := 'AppVersion={#AppVersion}';
  Lines[1] := 'DataDir=' + GetDataDir('');
  Lines[2] := 'Hostname=' + Lowercase(Trim(NetworkPage.Values[0]));
  Lines[3] := 'HttpsPort=' + Trim(NetworkPage.Values[1]);
  Lines[4] := 'HttpPort=' + Trim(NetworkPage.Values[2]);
  Lines[5] := 'AdminUser=' + AdminPage.Values[0];
  Lines[6] := 'AdminPassword=' + AdminPage.Values[1];
  SaveStringsToUTF8File(FileName, Lines, False);
end;

procedure ConfigureServices;
var
  ResultCode: Integer;
  Answers: String;
begin
  Answers := ExpandConstant('{tmp}\answers.txt');
  WriteAnswers(Answers);
  WizardForm.StatusLabel.Caption := 'Setting up the database and services. The first start can take a few minutes...';
  WizardForm.ProgressGauge.Style := npbstMarquee;
  try
    if not RunPowerShell('-File "' + ExpandConstant('{app}\scripts\setup.ps1') + '" -AnswersFile "' + Answers + '"',
        ResultCode) or (ResultCode <> 0) then
      MsgBox('Premium HRM was installed, but configuring it failed.' + #13#10#13#10 +
        'See ' + GetDataDir('') + '\logs\setup.log, fix the cause and run this setup again: ' +
        'it continues where it stopped.', mbError, MB_OK);
  finally
    WizardForm.ProgressGauge.Style := npbstNormal;
    DeleteFile(Answers);
  end;
end;

procedure CurStepChanged(CurStep: TSetupStep);
begin
  if CurStep = ssPostInstall then begin
    InstallVCRedist;
    ConfigureServices;
  end;
end;

function InitializeUninstall: Boolean;
begin
  if not RegQueryStringValue(HKLM64, '{#RegKey}', 'DataDir', UninstallDataDir) then
    UninstallDataDir := '';
  Result := True;
end;

procedure CurUninstallStepChanged(CurUninstallStep: TUninstallStep);
begin
  if (CurUninstallStep = usPostUninstall) and (UninstallDataDir <> '') and DirExists(UninstallDataDir)
      and not UninstallSilent then
    if MsgBox('Also delete ALL Premium HRM data in' + #13#10 + UninstallDataDir + '?' + #13#10#13#10 +
        'This removes the database, uploaded documents, backups and configuration and cannot be undone. ' +
        'Choose No to keep it; installing Premium HRM again later reuses it.',
        mbConfirmation, MB_YESNO or MB_DEFBUTTON2) = IDYES then
      DelTree(UninstallDataDir, True, True, True);
end;
