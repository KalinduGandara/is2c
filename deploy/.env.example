# Copy to deploy/.env and change every value marked CHANGE. Never commit deploy/.env.

# --- required -------------------------------------------------------------------------------
HRM_DB_PASSWORD=CHANGE-a-long-random-password
# at least 32 random bytes, e.g. `openssl rand -base64 48`; the app refuses to start without it
HRM_JWT_SECRET=CHANGE-use-openssl-rand-base64-48
# first administrator, created only when no user exists; must change the password at first login
HRM_ADMIN_USERNAME=admin
HRM_ADMIN_PASSWORD=CHANGE-Initial#Pass123

# --- on-prem: host name users type in the browser (DNS name or IP) --------------------------
HRM_HOSTNAME=hrm.local
# --- cloud: public DNS name pointing at this server, and the ACME contact ------------------
HRM_DOMAIN=hrm.example.com
HRM_ACME_EMAIL=ops@example.com

# --- optional ---------------------------------------------------------------------------------
# HRM_IMAGE=is2c/hrm:1.0.0
# HRM_HTTP_PORT=80
# HRM_HTTPS_PORT=443
# HRM_BACKUP_DIR=./backups
HRM_BACKUP_RETENTION_DAYS=14
HRM_BACKUP_AT=02:00
TZ=Asia/Colombo

# outgoing email (payslips, approval notifications)
HRM_MAIL_ENABLED=false
HRM_SMTP_HOST=smtp.example.com
HRM_SMTP_PORT=587
HRM_SMTP_USERNAME=
HRM_SMTP_PASSWORD=
HRM_SMTP_AUTH=true
HRM_SMTP_STARTTLS=true
HRM_MAIL_FROM=hrm@example.com

# OpenAPI docs at /api/docs/ui
HRM_API_DOCS=false
